# StackStorm backend: environment variable template
# Copy this file to .env and fill in your local values.
# NEVER commit .env to Git.

# Application
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stackstorm_dev

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_WORK_FACTOR=12

# Payment (Stripe)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email (SendGrid)
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=noreply@stackstorm.lk

# File storage (AWS S3)
AWS_S3_BUCKET=stackstorm-uploads
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_REGION=ap-south-1

# Frontend
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=debug
